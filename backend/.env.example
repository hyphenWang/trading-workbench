# 复制为 .env 后按需修改。
# 访问 Binance / Yahoo 需要代理时，取消注释并改成你的代理地址：
# 注意：httpx 会自动读取这两个环境变量；建议同时设置 NO_PROXY 排除本机地址。
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1

# Binance REST/WS 入口（被墙时可换备用域名，如 https://data-api.binance.vision）
BINANCE_BASE=https://api.binance.com
BINANCE_WS=wss://stream.binance.com:9443

# 实时行情：1=启用 Binance WebSocket（失败自动回退 REST 轮询），0=只用轮询
REALTIME_WS_ENABLED=1
